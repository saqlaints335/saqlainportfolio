# Copy this file to ".env" for local development.
# On Vercel add the same names in: Project > Settings > Environment Variables

# ---------- Contact form (EmailJS) ----------
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ---------- Your live domain (no trailing slash) ----------
# Used for canonical URLs, sitemap.xml and social previews.
VITE_SITE_URL=https://your-domain.com

# ---------- Admin panel login ----------
# Open  https://your-domain.com/wp-admin  (change the address with VITE_ADMIN_PATH)
ADMIN_USERNAME=choose-a-username
ADMIN_PASSWORD=choose-a-long-strong-password
# Any long random text (32+ characters). Never share it.
SESSION_SECRET=
# Optional: secret admin address, e.g. /saqlain-control  (default is /wp-admin)
VITE_ADMIN_PATH=/wp-admin

# ---------- Storage ----------
# BLOB_READ_WRITE_TOKEN is added automatically on Vercel when you connect a Blob store.
# Leave it empty locally: content is saved in the ".local-data" folder instead.
BLOB_READ_WRITE_TOKEN=

# ---------- Auto card from link (optional) ----------
# The screenshot service (Microlink) works free without a key (about 25-50 screenshots per day).
# Add a key only if you need more.
MICROLINK_API_KEY=
